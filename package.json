{
  "name": "recordbridge-typescript-checks",
  "private": true,
  "description": "Strict type-check of the generated golden files. The Java build doesn't need Node.",
  "scripts": {
    "check:ts": "tsc -p emitter-ts/src/test/typescript",
    "test:ts": "node --test emitter-ts/src/test/typescript/*.test.ts"
  },
  "devDependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@types/node": "24.19.2",
    "rxjs": "7.8.2",
    "typescript": "7.0.2"
  }
}
